# Paper-trading loop for the ops-mcp container. Installed on the VPS host by the controller.
# Each job first asks Alpaca's calendar for a session and exits 0 on a holiday.
CRON_TZ=America/New_York
45 8 * * 1-5 docker exec ops-mcp python trader_job.py morning >> /var/log/ops-trader.log 2>&1
0 10 * * 1-5 docker exec ops-mcp python trader_job.py propose >> /var/log/ops-trader.log 2>&1
30 10 * * 1-5 docker exec ops-mcp python trader_job.py propose >> /var/log/ops-trader.log 2>&1
55 15 * * 1-5 docker exec ops-mcp python trader_job.py flatten >> /var/log/ops-trader.log 2>&1
